        <version.junit>6.1.0</version.junit>
        <hamcrest.version>3.0</hamcrest.version>
        <geotools.version>35.0</geotools.version>
        <geolatte.version>1.12</geolatte.version>
        <hibernate.version>6.6.54.Final</hibernate.version>
        <jakarta.version>3.2.0</jakarta.version>
        <version.slf4j>2.0.18</version.slf4j>
        <version.jakarta-annotation-api>3.0.0</version.jakarta-annotation-api>

        <postgresql.version>42.7.11</postgresql.version>
        <postgis.version>2025.1.1</postgis.version>
        <h2.version>2.4.240</h2.version>
        <version.java>17</version.java>
        <timestamp>${maven.build.timestamp}</timestamp>
        <maven.build.timestamp.format>yyyy</maven.build.timestamp.format>
        <currentYearDynamic>${maven.build.timestamp}</currentYearDynamic>
        <file.encoding>UTF-8</file.encoding>

        <!-- OpenRewrite migration tooling (only used by the 'rewrite' profile) -->
        <version.rewrite.plugin>6.41.0</version.rewrite.plugin>
        <version.rewrite.recipe.bom>3.32.0</version.rewrite.recipe.bom>
        <version.rewrite.spring>6.32.1</version.rewrite.spring>
        <version.rewrite.migrate-java>3.36.0</version.rewrite.migrate-java>
        <version.rewrite.hibernate>2.21.0</version.rewrite.hibernate>
        <version.rewrite.testing-frameworks>3.37.0</version.rewrite.testing-frameworks>
    </properties>

    <dependencyManagement>
