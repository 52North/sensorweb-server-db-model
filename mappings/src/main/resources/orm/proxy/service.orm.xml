<?xml version="1.0" encoding="UTF-8"?>
<!--
  Profile-specific JPA mapping override for the "proxy" persistence unit.

  DescribableEntity#service is annotated @Transient by default (entities module) because
  not every profile's schema has a service/fk_service_id column. This file turns it back
  into a real many-to-one mapping for every DescribableEntity subclass, for consumers that
  build the "proxy" persistence unit only - reference this file from that persistence.xml's
  <mapping-file>.

  Applying the override at the mapped-superclass level (rather than once per concrete entity
  class) means every DescribableEntity subclass shares the same fk_service_id join column and
  the same fk_service foreign-key constraint name in this profile.
-->
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_0.xsd"
                  version="3.0">

    <mapped-superclass class="org.n52.series.db.beans.DescribableEntity" metadata-complete="false">
        <attributes>
            <many-to-one name="service" target-entity="org.n52.series.db.beans.ServiceEntity" fetch="LAZY">
                <join-column name="fk_service_id"/>
                <foreign-key name="fk_service"/>
            </many-to-one>
        </attributes>
    </mapped-superclass>

</entity-mappings>
